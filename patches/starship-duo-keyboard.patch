+
+// The iOS software keyboard belongs only to an ImGui text field that wants
+// input. SDL2 starts text input by default, and UIKit hands first responder
+// back to SDL's hidden text field whenever the window or scene changes size
+// (folding, unfolding or rotating the iPhone Duo), which pops the keyboard
+// over the game. Keep it closed unless ImGui asks for text.
+static UIView* sKeyboardProbe;
+
+static BOOL StarshipPad_ImGuiWantsText(void) {
+    return ImGui::GetCurrentContext() != nullptr && ImGui::GetIO().WantTextInput;
+}
+
+static void StarshipPad_CloseKeyboard(void) {
+    if (ImGui::GetCurrentContext() != nullptr && ImGui::GetIO().WantTextInput) {
+        ImGui::ClearActiveID();
+    }
+    if (SDL_IsTextInputActive()) {
+        SDL_StopTextInput();
+    }
+    [StarshipPad_ActiveWindow() endEditing:YES];
+}
+
+static void StarshipPad_DismissUnwantedKeyboard(void) {
+    if (StarshipPad_ImGuiWantsText()) {
+        return;
+    }
+    const BOOL wasActive = SDL_IsTextInputActive();
+    if (wasActive) {
+        SDL_StopTextInput();
+    }
+    if ([StarshipPad_ActiveWindow() endEditing:YES] || wasActive) {
+        SDL_Log("StarshipPad dismissed unwanted keyboard (text input was %s)",
+                wasActive ? "active" : "inactive");
+    }
+}
