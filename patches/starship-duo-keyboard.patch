+@implementation StarshipPadKeyboardBar
+
+- (instancetype)initWithFrame:(CGRect)frame {
+    self = [super initWithFrame:frame];
+    if (self != nil) {
+        // Opaque: an input accessory view gets no keyboard backdrop.
+        self.backgroundColor = UIColor.secondarySystemBackgroundColor;
+        self.autoresizingMask = UIViewAutoresizingFlexibleWidth;
+        UIView* hairline = [[UIView alloc] initWithFrame:CGRectZero];
+        hairline.backgroundColor = UIColor.separatorColor;
+        hairline.translatesAutoresizingMaskIntoConstraints = NO;
+        [self addSubview:hairline];
+
+        UIButtonConfiguration* config = [UIButtonConfiguration filledButtonConfiguration];
+        config.title = @"Done";
+        config.image = [UIImage systemImageNamed:@"keyboard.chevron.compact.down"];
+        config.imagePlacement = NSDirectionalRectEdgeLeading;
+        config.imagePadding = 6.0;
+        config.baseBackgroundColor = UIColor.systemGray4Color;
+        config.baseForegroundColor = UIColor.labelColor;
+        config.cornerStyle = UIButtonConfigurationCornerStyleCapsule;
+        UIButton* done = [UIButton buttonWithConfiguration:config primaryAction:nil];
+        done.accessibilityLabel = @"Close keyboard";
+        done.accessibilityIdentifier = @"keyboard-done";
+        done.translatesAutoresizingMaskIntoConstraints = NO;
+        [done addTarget:self
+                      action:@selector(closeKeyboard)
+            forControlEvents:UIControlEventTouchUpInside];
+        [self addSubview:done];
+
+        [NSLayoutConstraint activateConstraints:@[
+            [hairline.topAnchor constraintEqualToAnchor:self.topAnchor],
+            [hairline.leadingAnchor constraintEqualToAnchor:self.leadingAnchor],
+            [hairline.trailingAnchor constraintEqualToAnchor:self.trailingAnchor],
+            [hairline.heightAnchor constraintEqualToConstant:0.5],
+            [done.trailingAnchor constraintEqualToAnchor:self.safeAreaLayoutGuide.trailingAnchor
+                                                constant:-12.0],
+            [done.centerYAnchor constraintEqualToAnchor:self.centerYAnchor],
+        ]];
+    }
+    return self;
 }
 
+- (void)closeKeyboard {
+    StarshipPad_CloseKeyboard();
+}
