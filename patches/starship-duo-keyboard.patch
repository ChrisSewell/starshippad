+static UITextField* StarshipPad_FindTextField(UIView* view) {
+    if ([view isKindOfClass:UITextField.class]) {
+        return (UITextField*)view;
+    }
+    for (UIView* subview in view.subviews) {
+        UITextField* found = StarshipPad_FindTextField(subview);
+        if (found != nil) {
+            return found;
+        }
+    }
+    return nil;
+}
+
+// SDL's hidden text field is what the keyboard serves; give it the Done bar.
+static void StarshipPad_ConfigureKeyboardBar(void) {
+    UITextField* field = StarshipPad_FindTextField(StarshipPad_ActiveWindow());
+    if (field == nil || [field.inputAccessoryView isKindOfClass:StarshipPadKeyboardBar.class]) {
+        return;
+    }
+    field.inputAccessoryView =
+        [[StarshipPadKeyboardBar alloc] initWithFrame:CGRectMake(0.0, 0.0, 320.0, 50.0)];
+    if (field.isFirstResponder) {
+        [field reloadInputViews];
+    }
+}
