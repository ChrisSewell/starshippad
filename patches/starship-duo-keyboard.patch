+// A full-window, non-interactive view whose layout pass runs on every window
+// or scene geometry change (fold, unfold, rotate, display switch).
+@interface StarshipPadKeyboardProbe : UIView
+@end
+
+@implementation StarshipPadKeyboardProbe
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    StarshipPad_ConfigureKeyboardBar();
+    StarshipPad_DismissUnwantedKeyboard();
+    // UIKit may restore first responder after this pass; check once more.
+    dispatch_async(dispatch_get_main_queue(), ^{
+        StarshipPad_DismissUnwantedKeyboard();
+    });
+}
+
+@end
