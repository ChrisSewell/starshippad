+static void StarshipPad_InstallKeyboardGuard(UIWindow* window) {
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        SDL_SetHint(SDL_HINT_RETURN_KEY_HIDES_IME, "1");
+        NSNotificationCenter* notifications = NSNotificationCenter.defaultCenter;
+        [notifications
+            addObserverForName:UIKeyboardWillShowNotification
+                        object:nil
+                         queue:NSOperationQueue.mainQueue
+                    usingBlock:^(NSNotification* notification) {
+                        (void)notification;
+                        StarshipPad_ConfigureKeyboardBar();
+                        // Let SDL's own observer run first, then undo it.
+                        dispatch_async(dispatch_get_main_queue(), ^{
+                            StarshipPad_DismissUnwantedKeyboard();
+                        });
+                    }];
+        [notifications
+            addObserverForName:UIKeyboardDidHideNotification
+                        object:nil
+                         queue:NSOperationQueue.mainQueue
+                    usingBlock:^(NSNotification* notification) {
+                        (void)notification;
+                        // Hidden some other way (Return, swipe): keep ImGui in step.
+                        if (StarshipPad_ImGuiWantsText()) {
+                            ImGui::ClearActiveID();
+                        }
+                        if (SDL_IsTextInputActive()) {
+                            SDL_StopTextInput();
+                        }
+                    }];
+        // SDL starts text input when its window is created.
+        StarshipPad_DismissUnwantedKeyboard();
+    });
+    if (sKeyboardProbe == nil) {
+        sKeyboardProbe = [[StarshipPadKeyboardProbe alloc] initWithFrame:window.bounds];
+        sKeyboardProbe.userInteractionEnabled = NO;
+        sKeyboardProbe.autoresizingMask =
+            UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+    }
+    if (sKeyboardProbe.superview != window) {
+        [sKeyboardProbe removeFromSuperview];
+        sKeyboardProbe.frame = window.bounds;
+        [window addSubview:sKeyboardProbe];
+        [window sendSubviewToBack:sKeyboardProbe];
+    }
+    StarshipPad_ConfigureKeyboardBar();
+}
